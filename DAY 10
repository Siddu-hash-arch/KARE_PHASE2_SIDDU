        System.out.println("Enter no of cols");
        int col = sc.nextInt();
        int [][] arr=new int[row][col];
        System.out.println("Enter array elements");
        
        for (int i =0;i<row;i++){
            for(int j=0;j<col;j++){
                arr[i][j]=sc.nextInt();

            }
        }
        int sum=0;
        for (int i =0;i<row;i++){
            for(int j=0;j<col;j++){
