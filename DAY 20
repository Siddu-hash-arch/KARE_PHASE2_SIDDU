// 1) Add elements to ArrayList and find the sum
// Input:
// 5
// 10 20 30 40 50
// Output:
// [10, 20, 30, 40, 50]
// Sum: 150

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        ArrayList<Integer> obj = new ArrayList<>();

        int n = sc.nextInt();

        int sum = 0;

        for(int i = 0; i < n; i++) {
            int a = sc.nextInt();
            obj.add(a);
            sum = sum + a;
        }

        System.out.println(obj);
        System.out.println("Sum: " + sum);
    }
}


// 2) Find maximum and minimum in ArrayList
// Input:
// 5
// 25 10 45 5 30
// Output:
// Maximum: 45
// Minimum: 5

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        ArrayList<Integer> obj = new ArrayList<>();

        int n = sc.nextInt();

        for(int i = 0; i < n; i++) {
            obj.add(sc.nextInt());
        }

        int max = obj.get(0);
        int min = obj.get(0);

        for(int i = 1; i < obj.size(); i++) {
            if(obj.get(i) > max) {
                max = obj.get(i);
            }

            if(obj.get(i) < min) {
                min = obj.get(i);
            }
        }

        System.out.println("Maximum: " + max);
        System.out.println("Minimum: " + min);
    }
}


// 3) Search an element in ArrayList
// Input:
// 5
// 10 20 30 40 50
// 30
// Output:
// Element found at index: 2

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        ArrayList<Integer> obj = new ArrayList<>();

        int n = sc.nextInt();

        for(int i = 0; i < n; i++) {
            obj.add(sc.nextInt());
        }

        int target = sc.nextInt();

        int index = obj.indexOf(target);

        if(index != -1) {
            System.out.println("Element found at index: " + index);
        }
        else {
            System.out.println("Element not found");
        }
    }
}


// 4) Remove an element from ArrayList
// Input:
// 5
// 10 20 30 40 50
// 30
// Output:
// [10, 20, 40, 50]

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        ArrayList<Integer> obj = new ArrayList<>();

        int n = sc.nextInt();

        for(int i = 0; i < n; i++) {
            obj.add(sc.nextInt());
        }

        int value = sc.nextInt();

        if(obj.contains(value)) {
            obj.remove(Integer.valueOf(value));
            System.out.println(obj);
        }
        else {
            System.out.println("Element not found");
        }
    }
}


