import java.util.*;
class Stack {
        int top;
        int arr[];
        int n;
        Stack(int n) {
                this.n=n;
                this.top=-1;
                arr = new int[n];
        }
        void push(int d) {
                if(top==n-1) {
                        System.out.print("Over flow");
                        return;
                }
                arr[++top]=d;
                return;
        }
        void pop() {
                if(top==-1) {
                        System.out.print("Under flow");
                        return;
                }
                System.out.print(arr[top--]);
                return;
        }
        void peek() {
                if(top==-1) {
                        System.out.println("Under flow");
                        return;
                }
                System.out.print(arr[top]);
                return;
        }
        void display() {
                if(top==-1) {
                        System.out.println("Stack is empty");
                        return;
                }
                for(int i=top; i>=0; i--) {
                        System.out.print(arr[i]+" ");
                }
                return;
        }
}
