import java.util.*;

class Queue {
    int front;
    int rear;
    int n;
    int queue[];

    Queue(int n) {
        this.n = n;
        front = 0;
        rear = -1;
        queue = new int[n];
    }

    void enqueue(int data) {
        if(rear == n-1) {
            System.out.println("Queue is full");
            return;
        }

        queue[++rear] = data;
    }

    void sum() {
        int sum = 0;

        for(int i = front; i <= rear; i++) {
            sum = sum + queue[i];
        }

        System.out.println("Sum of Elements: " + sum);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        Queue q = new Queue(n);

        for(int i = 0; i < n; i++) {
            q.enqueue(sc.nextInt());
        }

        q.sum();
    }
}


