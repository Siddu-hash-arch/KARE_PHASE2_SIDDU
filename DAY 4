/base-1 pattern
import java.util.Scanner;
public class index {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int row,col;
        for(row=0;row<n;row++,System.out.println()){
            for (col=0;col<n;col++){
                System.out.print("*");
            }
        }

    }
}


