// Find Second Largest Element in Circular Singly Linked List
// Input:
// 10 50 20 40 30 -1
// Output:
// Second Largest Element: 40

import java.util.*;
class Node{
    int data;
    Node next;
    Node(int d){
        data = d;
        next = null;
    }
}
public class Main
{
    Node first = null;
    void insert(int d){
        Node n = new Node(d);
        if(first == null){
            first = n;
            n.next = first;
            return;
        }
        Node temp = first;
        while(temp.next != first){
            temp = temp.next;
        }
        temp.next = n;
        n.next = first;
    }
    void secondLargest(){
        if(first == null){
            System.out.println("List is empty");
            return;
        }
        int largest = Integer.MIN_VALUE;
        int second = Integer.MIN_VALUE;
        Node temp = first;
        do{
            if(temp.data > largest){
                second = largest;
                largest = temp.data;
            }
            else if(temp.data > second && temp.data != largest){
                second = temp.data;
            }
            temp = temp.next;
        }while(temp != first);
        System.out.println("Second Largest Element: " + second);
    }
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        Main m = new Main();
        int d = sc.nextInt();
        while(d != -1){
            m.insert(d);
            d = sc.nextInt();
        }
        m.secondLargest();
    }
}
