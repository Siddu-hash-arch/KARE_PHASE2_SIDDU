// Search Element in Circular Singly Linked List
// Input:
// 10 20 30 40 50 -1
// 30
// Output:
// Element found

import java.util.*;

class Node{
    int data;
    Node next;

    Node(int d){
        data = d;
        next = null;
    }
}
public class Main
{
    Node first = null;

    void insert(int d){
        Node n = new Node(d);

        if(first == null){
            first = n;
            n.next = first;
            return;
        }

        Node temp = first;

        while(temp.next != first){
            temp = temp.next;
        }

        temp.next = n;
        n.next = first;
    }

    void search(){
        Scanner sc = new Scanner(System.in);

        int target = sc.nextInt();
        int flag = 0;

        Node temp = first;

        if(first == null){
            System.out.println("List is empty");
            return;
        }

        do{
            if(temp.data == target){
                flag = 1;
                break;
            }

            temp = temp.next;
        }while(temp != first);
        if(flag == 1){
            System.out.println("Element found");
        }
        else{
            System.out.println("Element not found");
        }
    }
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        Main m = new Main();
        int d = sc.nextInt();
        while(d != -1){
            m.insert(d);
            d = sc.nextInt();
        }
        m.search();
    }
}
// Count Even and Odd Elements in Circular Doubly Linked List
// Input:
// 10 15 20 25 30 -1
// Output:
// Even elements: 3
// Odd elements: 2
import java.util.*;
class Node{
    int data;
    Node next;
    Node prev;
    Node(int d){
        data = d;
        next = null;
        prev = null;
    }
}
public class Main
{
    Node first = null;
    void insert(int d){
        Node n = new Node(d);
        if(first == null){
            first = n;
            first.next = first;
            first.prev = first;
            return;
        }
        Node last = first.prev;
        last.next = n;
        n.prev = last;
        n.next = first;
        first.prev = n;
    }
    void count(){
        if(first == null){
            System.out.println("List is empty");
            return;
        }
        int even = 0;
