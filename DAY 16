// 1) Count the number of elements
// Input:
// 10 20 30 40 50 -1
// Output:
// Number of Elements: 5

import java.util.*;

class Node{
    int data;
    Node next;
    Node previous;

    Node(int d){
        this.data = d;
        this.next = null;
        this.previous = null;
    }
}

public class Main
{
    Node first;

    void insert(int d){
        Node n = new Node(d);

        if(first == null){
            first = n;
            return;
        }

        Node temp = first;

        while(temp.next != null){
            temp = temp.next;
        }

        temp.next = n;
        n.previous = temp;
    }

    void count(){
        if(first == null){
            System.out.println("List is empty");
            return;
        }

        int count = 0;
        Node temp = first;

        while(temp != null){
            count++;
            temp = temp.next;
        }

        System.out.println("Number of Elements: " + count);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Main m = new Main();

        int d = sc.nextInt();

        while(d != -1){
            m.insert(d);
            d = sc.nextInt();
        }

        m.count();
    }
}


// 2) Search an element
// Input:
// 10 20 30 40 50 -1
// 30
// Output:
// Element found

import java.util.*;

class Node{
    int data;
    Node next;
    Node previous;

    Node(int d){
        this.data = d;
        this.next = null;
        this.previous = null;
    }
}

public class Main
{
    Node first;

    void insert(int d){
        Node n = new Node(d);

        if(first == null){
            first = n;
            return;
        }

        Node temp = first;

        while(temp.next != null){
            temp = temp.next;
        }

        temp.next = n;
        n.previous = temp;
    }

    void search(){
        Scanner sc = new Scanner(System.in);

        int target = sc.nextInt();
        int flag = 0;

        Node temp = first;

        while(temp != null){
            if(temp.data == target){
                flag = 1;
                break;
            }

            temp = temp.next;
        }

        if(flag == 1){
            System.out.println("Element found");
        }
        else{
            System.out.println("Element not found");
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Main m = new Main();

        int d = sc.nextInt();

        while(d != -1){
            m.insert(d);
            d = sc.nextInt();
        }

        m.search();
    }
}


