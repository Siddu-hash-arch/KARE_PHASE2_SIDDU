// 5) Find the second largest element
// Input:
// 10 50 20 40 30 -1
// Output:
// Second Largest Element: 40

import java.util.*;

class Node{
    int data;
    Node next;
    Node previous;

    Node(int d){
        this.data = d;
        this.next = null;
        this.previous = null;
    }
}

public class Main
{
    Node first;

    void insert(int d){
        Node n = new Node(d);

        if(first == null){
            first = n;
            return;
        }

        Node temp = first;

        while(temp.next != null){
            temp = temp.next;
        }

        temp.next = n;
        n.previous = temp;
    }

    void secondLargest(){
        if(first == null){
            System.out.println("List is empty");
            return;
        }

        int largest = Integer.MIN_VALUE;
        int second = Integer.MIN_VALUE;

        Node temp = first;

        while(temp != null){

            if(temp.data > largest){
                second = largest;
                largest = temp.data;
            }
            else if(temp.data > second && temp.data != largest){
                second = temp.data;
            }

            temp = temp.next;
        }

        System.out.println("Second Largest Element: " + second);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Main m = new Main();

        int d = sc.nextInt();

        while(d != -1){
            m.insert(d);
            d = sc.nextInt();
        }

        m.secondLargest();
    }
}


// 6) Display elements from a given position
// Input:
// 10 20 30 40 50 -1
// 3
// Output:
// 30 40 50

import java.util.*;

class Node{
    int data;
    Node next;
    Node previous;

    Node(int d){
        this.data = d;
        this.next = null;
        this.previous = null;
    }
}

public class Main
{
    Node first;

    void insert(int d){
        Node n = new Node(d);

        if(first == null){
            first = n;
            return;
        }

        Node temp = first;

        while(temp.next != null){
            temp = temp.next;
        }

        temp.next = n;
        n.previous = temp;
    }

    void displayFromPosition(){
        Scanner sc = new Scanner(System.in);

        int position = sc.nextInt();

        Node temp = first;
        int count = 1;

        while(temp != null && count < position){
            temp = temp.next;
            count++;
        }

        if(temp == null){
            System.out.println("Invalid Position");
            return;
        }

        while(temp != null){
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Main m = new Main();

        int d = sc.nextInt();

        while(d != -1){
            m.insert(d);
            d = sc.nextInt();
        }

        m.displayFromPosition();
    }
}
