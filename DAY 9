import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int [] arr=new int[n];
        int zc=0,oc=0;
        for (int i =0;i<n;i++){
            arr[i]=sc.nextInt();
            if(arr[i]==0)
                zc++;
            else
                oc++;
        }
        for(int i=0;i<=zc;i++){
            arr[i]=0;
        }
        for(int i=zc;i<n;i++){
            arr[i]=1;
        }
        for(int i=0;i<n;i++){
            System.out.print(arr[i]+" ");
        }
    }
}

