//write the java programe to print single number
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int [] arr=new int[n];
        for (int i =0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int m=0;
        for(int i=0;i<arr.length;i++){
            m=m^arr[i];
        }
        System.out.println(m);
    }
}
//write the java programe to print missing number
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int [] arr=new int[n];
        int sum=0,sum1=0;
        for (int i =0;i<n-1;i++){
            arr[i]=sc.nextInt();
            sum+=arr[i];
        }
        sum1=(n*(n+1))/2;
        System.out.println(sum1-sum);
    }
}

