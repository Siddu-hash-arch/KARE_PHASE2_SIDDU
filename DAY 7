import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int d,temp=n,sum=0,c=0;
        while(n!=0){
            n=n/10;
            c++;
        }
        n=temp;
        while(n!=0){
            d=n%10;
            sum+=(int)Math.pow(d, c);
            n=n/10;
        }
        if (sum==temp)
            System.out.println("ArmStrong number");
        else
            System.out.println("not a ArmStrong number");
    }
}
