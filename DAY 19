// 8) Check Whether Graph Has a Self Loop
// Input:
// 4 4
// 0 1
// 1 2
// 2 2
// 2 3
//
// Output:
// Graph contains self loop

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int V = sc.nextInt();
        int E = sc.nextInt();

        int matrix[][] = new int[V][V];

        for(int i = 0; i < E; i++) {
            int u = sc.nextInt();
            int v = sc.nextInt();

            matrix[u][v] = 1;
            matrix[v][u] = 1;
        }

        int flag = 0;

        for(int i = 0; i < V; i++) {
            if(matrix[i][i] == 1) {
                flag = 1;
                break;
            }
        }

        if(flag == 1) {
            System.out.println("Graph contains self loop");
        }
        else {
            System.out.println("Graph does not contain self loop");
        }
    }
}


// 9) Count Vertices With Even Degree
// Input:
// 5 5
// 0 1
// 0 2
// 1 2
// 2 3
// 3 4
//
// Output:
// Vertices with even degree: 3

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int V = sc.nextInt();
        int E = sc.nextInt();

        int matrix[][] = new int[V][V];

        for(int i = 0; i < E; i++) {
            int u = sc.nextInt();
            int v = sc.nextInt();

            matrix[u][v] = 1;
            matrix[v][u] = 1;
        }

        int count = 0;

        for(int i = 0; i < V; i++) {
            int degree = 0;

            for(int j = 0; j < V; j++) {
                degree = degree + matrix[i][j];
            }

            if(degree % 2 == 0) {
                count++;
            }
        }

        System.out.println("Vertices with even degree: " + count);
    }
}
